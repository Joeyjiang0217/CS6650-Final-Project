# 1. 获取任务列表
aws ecs list-tasks \
  --cluster chatroom-dev-cluster \
  --service-name chatroom-dev-gateway \
  --region us-west-2

# 2. 停止一个任务（复制上面命令输出的某个任务ARN）
aws ecs stop-task \
  --cluster chatroom-dev-cluster \
  --task <TASK_ARN> \
  --region us-west-2

